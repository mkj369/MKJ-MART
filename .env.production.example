# ───────────────────────────────────────────────────────────────────────────────
# MKJ MART — PRODUCTION configuration for docker-compose.prod.yml
#   cp .env.production.example .env.production && chmod 600 .env.production
# Keep this file ONLY on the server (it is git- and docker-ignored). Fill in every REQUIRED value.
# Generate secrets with:  openssl rand -hex 32
# ───────────────────────────────────────────────────────────────────────────────

# REQUIRED — your domain (DNS A/AAAA record must point at this server) and Let's Encrypt contact.
DOMAIN=shop.example.com
ACME_EMAIL=ops@example.com
APP_URL=https://shop.example.com

# REQUIRED — database password (used by the db, app, migrate and backup containers).
POSTGRES_PASSWORD=

# REQUIRED — secret for the internal scheduler → /api/cron/* (min 16 chars).
CRON_SECRET=

# ── Payments: SSLCommerz ──────────────────────────────────────────────────────
# Blank = online payment hidden (Cash on Delivery only). Use sandbox credentials until the
# sandbox checklist in docs/SSLCOMMERZ.md passes, then switch to live credentials + MODE=live.
# In the SSLCommerz merchant panel, set the IPN URL to  https://<DOMAIN>/api/payments/sslcommerz/ipn
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox
PAYMENT_TIMEOUT_MINUTES=30

# ── Email (SMTP) — strongly recommended (order emails, password reset) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MKJ Store <orders@example.com>"
SMTP_REPLY_TO=

# ── SMS (optional) — see .env.example for the provider settings ───────────────
SMS_PROVIDER=

# ── Image storage ──────────────────────────────────────────────────────────────
# local = the "uploads" Docker volume (included in backups). Or s3 (see .env.example).
STORAGE_DRIVER=local

# ── Backups (written to BACKUP_DIR on the host; copy them off-site!) ───────────
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ── Security ───────────────────────────────────────────────────────────────────
CSP_FRAME_ANCESTORS='self'
# Leave COOKIE_SAMESITE unset (Lax). "none" exists only for iframe previews — see docs/SECURITY.md.
# Never enable DEMO_MODE on a real store.
DEMO_MODE=false

# ── MKJ Ecosystem webhook (optional) ───────────────────────────────────────────
ECOSYSTEM_WEBHOOK_URL=
ECOSYSTEM_WEBHOOK_SECRET=
