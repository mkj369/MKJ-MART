# ───────────────────────────────────────────────────────────────────────────────
# MKJ MART — environment configuration
# Copy to `.env.local` for local development:  cp .env.example .env.local
# NEVER commit real credentials. In production, set these in your host's secret store.
# ───────────────────────────────────────────────────────────────────────────────

# Public base URL of the storefront (no trailing slash). Used for payment callbacks,
# absolute links and origin checks. Must be the real public HTTPS URL in production.
APP_URL=http://localhost:3000

# ── Database (PostgreSQL 14+) ──────────────────────────────────────────────────
# Local, no Docker:   npm run db:local   (uses the credentials below; data in ./.data/postgres)
# Docker:             docker compose up -d db   → postgres://mkj:mkj_local_dev@127.0.0.1:5433/mkj_mart
# Managed (Neon, Supabase, RDS, Railway…): paste their connection string, usually with ?sslmode=require
DATABASE_URL=postgres://mkj:mkj_local_dev@127.0.0.1:5433/mkj_mart
# Optional connection pool size per app instance (default 10)
# DATABASE_POOL_MAX=10

# ── Sessions & cookies ─────────────────────────────────────────────────────────
# "auto" = Secure cookies when NODE_ENV=production. Set "false" only for plain-HTTP test servers.
COOKIE_SECURE=auto
# Trust X-Forwarded-For for client IPs (rate limiting). Enable only behind a trusted proxy/CDN.
TRUST_PROXY=false

# ── Media uploads ──────────────────────────────────────────────────────────────
# Directory for admin-uploaded product images (served at /media/*). Use a persistent volume in production.
UPLOAD_DIR=./uploads

# ── Payments: SSLCommerz (bKash, Nagad, Rocket, cards, net banking) ───────────
# Leave blank to disable online payment (Cash on Delivery keeps working).
# Sandbox credentials: register at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "sandbox" or "live"
SSLCOMMERZ_MODE=sandbox
# Minutes an online-payment order may stay unpaid before it is cancelled and stock released.
PAYMENT_TIMEOUT_MINUTES=30

# ── Scheduled jobs ─────────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/* endpoints (expire unpaid orders, dispatch events).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Security headers ───────────────────────────────────────────────────────────
# Who may embed the site in an iframe (CSP frame-ancestors). Default: only this site.
CSP_FRAME_ANCESTORS='self'

# ── MKJ Ecosystem integration (optional) ───────────────────────────────────────
# Domain events (order.placed, order.status_changed, payment.succeeded…) are POSTed here,
# signed with HMAC-SHA256 in the `X-MKJ-Signature` header.
ECOSYSTEM_WEBHOOK_URL=
ECOSYSTEM_WEBHOOK_SECRET=

# ── Seeding (used by `npm run db:seed` / `npm run admin:create`) ──────────────
# Demo data is NEVER loaded automatically. These are only for creating your first real admin:
# ADMIN_EMAIL=owner@yourdomain.com
# ADMIN_PASSWORD=use-a-long-unique-password
# ADMIN_NAME=Store Owner
