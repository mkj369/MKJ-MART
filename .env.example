# ───────────────────────────────────────────────────────────────────────────────
# MKJ MART — environment configuration
# Copy to `.env.local` for local development:  cp .env.example .env.local
# NEVER commit real credentials. In production, set these in your host's secret store.
# ───────────────────────────────────────────────────────────────────────────────

# Public base URL of the storefront (no trailing slash). Used for payment callbacks,
# absolute links and origin checks. Must be the real public HTTPS URL in production.
APP_URL=http://localhost:3000

# ── Database (PostgreSQL 14+) ──────────────────────────────────────────────────
# Local, no Docker:   npm run db:local   (uses the credentials below; data in ./.data/postgres)
# Docker:             docker compose up -d db   → postgres://mkj:mkj_local_dev@127.0.0.1:5433/mkj_mart
# Managed (Neon, Supabase, RDS, Railway…): paste their connection string, usually with ?sslmode=require
DATABASE_URL=postgres://mkj:mkj_local_dev@127.0.0.1:5433/mkj_mart
# Optional connection pool size per app instance (default 10)
# DATABASE_POOL_MAX=10

# ── Sessions & cookies ─────────────────────────────────────────────────────────
# "auto" = Secure cookies when NODE_ENV=production. Set "false" only for plain-HTTP test servers.
COOKIE_SECURE=auto
# SameSite for the session/cart cookies: lax (default) | strict | none. "none" is ONLY for running the
# store inside a cross-site iframe (e.g. a hosted preview panel); it forces Secure + Partitioned and also
# needs CSP_FRAME_ANCESTORS below. Leave unset on a real store.
# COOKIE_SAMESITE=lax
# Preview-only: when a hosting proxy strips the Cookie request header (seen in the Arena preview), carry the
# session and guest bag in x-mkj-* headers instead. Works only with DEMO_MODE=true; never on a real store.
# SESSION_HEADER_FALLBACK=false
# Trust X-Forwarded-For for client IPs (rate limiting). Enable only behind a trusted proxy/CDN.
TRUST_PROXY=false

# ── Media uploads ──────────────────────────────────────────────────────────────
# "local" (default): files in UPLOAD_DIR (served at /media/*) — use a persistent, backed-up volume.
# "s3": any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=mkj-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=

# ── Payments: SSLCommerz (bKash, Nagad, Rocket, cards, net banking) ───────────
# Leave blank to disable online payment (Cash on Delivery keeps working).
# Sandbox credentials: register at https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "sandbox" or "live"
SSLCOMMERZ_MODE=sandbox
# Minutes an online-payment order may stay unpaid before it is cancelled and stock released.
PAYMENT_TIMEOUT_MINUTES=30

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Order confirmations, status updates, password resets. Leave SMTP_HOST empty to disable email
# (messages are then recorded as "not sent" in the admin). Local testing: `npm run mail:dev`, then
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_REQUIRE_TLS=false
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465). Otherwise STARTTLS is required unless SMTP_REQUIRE_TLS=false.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MKJ Store <orders@example.com>"
# SMTP_REPLY_TO=care@example.com
# Minutes a password-reset link stays valid (10–180, default 30).
# PASSWORD_RESET_TTL_MINUTES=30

# ── SMS (optional) ─────────────────────────────────────────────────────────────
# Off unless SMS_PROVIDER is set: "twilio" or "http" (generic HTTP gateway, e.g. Bangladeshi providers).
SMS_PROVIDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX            (or TWILIO_MESSAGING_SERVICE_SID=MG…)
# SMS_HTTP_URL=https://gateway.example.com/api/send
# SMS_HTTP_METHOD=POST                 (POST or GET)
# SMS_HTTP_FORMAT=json                 (json or form)
# Placeholders: {{to}} 8801XXXXXXXXX · {{to_local}} 01XXXXXXXXX · {{message}} · {{id}} · {{api_key}} · {{sender_id}}
# SMS_HTTP_PARAMS={"api_key":"{{api_key}}","senderid":"{{sender_id}}","number":"{{to}}","message":"{{message}}"}
# SMS_HTTP_HEADERS={}
# SMS_HTTP_API_KEY=
# SMS_SENDER_ID=
# Regex the gateway's response body must match to count as accepted (recommended):
# SMS_HTTP_SUCCESS_PATTERN="response_code\":202"

# ── Scheduled jobs ─────────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/* endpoints (expire unpaid orders, send notifications, dispatch events).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Security headers ───────────────────────────────────────────────────────────
# Who may embed the site in an iframe (CSP frame-ancestors). Default: only this site.
# Space-separated sources, e.g. "self https://partner.example"; bare self/none are accepted.
CSP_FRAME_ANCESTORS='self'

# ── MKJ Ecosystem integration (optional) ───────────────────────────────────────
# Domain events (order.placed, order.status_changed, payment.succeeded…) are POSTed here,
# signed with HMAC-SHA256 in the `X-MKJ-Signature` header.
ECOSYSTEM_WEBHOOK_URL=
ECOSYSTEM_WEBHOOK_SECRET=

# ── Demo data (local development only) ─────────────────────────────────────────
# `npm run db:seed -- --demo` creates fictional demo accounts with RANDOM passwords printed once.
# Optionally set a stable password for them on your own machine (ignored in production):
# DEMO_ACCOUNT_PASSWORD=
# DEMO_MODE=true allows demo data/accounts in a PRODUCTION build — only for a deliberate public demo.
# DEMO_MODE=false

# ── First administrator ────────────────────────────────────────────────────────
# Recommended: `npm run admin:create -- --email owner@yourdomain.com` (prompts for the password).
# For unattended provisioning only (12+ chars; remove afterwards):
# ADMIN_EMAIL=owner@yourdomain.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Store Owner

# ── Logging ────────────────────────────────────────────────────────────────────
# JSON logs are always used in production; set LOG_FORMAT=json to get them in development too.
# LOG_FORMAT=json
